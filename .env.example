# Copy to .env before running docker compose up
# .env is gitignored

# Postgres
POSTGRES_USER=revolt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=revolt_dev

# Backend
DATABASE_URL=postgresql+asyncpg://revolt:changeme@db:5432/revolt_dev
SECRET_KEY=dev-insecure-change-in-prod
ENVIRONMENT=development
# CORS — add your Tailscale frontend URL here when accessing the GUI via tailnet
# ALLOWED_ORIGINS=http://localhost:5173,http://revolt-gui-dev:5173

# ROS2 bridge connection
# BRIDGE_TARGET: "physical" = real vessel hardware topics; "simulation" = pygemini/STC sim topics
#
# Option A — local dev with mock (docker compose --profile mock up):
VESSEL_HOST=rosbridge-mock
ROS2_BRIDGE_PORT=9090
BRIDGE_TARGET=physical
#
# Option B — physical vessel via Tailscale (docker compose --profile vessel up):
# VESSEL_HOST=vessel-proxy
# ROS2_BRIDGE_PORT=9090
# BRIDGE_TARGET=physical
#
# Option C — physical vessel on local LAN (no Tailscale needed, docker compose up):
# VESSEL_HOST=<vessel-lan-ip>        # e.g. 192.168.1.100 — vessel's IP on the local network
# ROS2_BRIDGE_PORT=9090
# BRIDGE_TARGET=physical
# If running on the vessel PC itself, use VESSEL_HOST=host-gateway instead.
#
# Option D — simulation environment (rosbridge running on sim host):
# VESSEL_HOST=<sim-host-tailscale-name>
# ROS2_BRIDGE_PORT=9090
# BRIDGE_TARGET=simulation
#
# Sim GNSS reference origin — real-world lat/lon that the simulation's X=0,Y=0 maps to.
# Used to convert local Cartesian metres (X=East, Y=North) to WGS84 for map display.
# Set to match the scenario's configured start position. Default: Bekkelaget, Oslo Fjord.
# SIM_GNSS_ORIGIN_LAT=59.9083
# SIM_GNSS_ORIGIN_LON=10.7512

# Tailscale sidecar
# Leave TAILSCALE_AUTHKEY empty to run without joining the tailnet (local dev only)
# Generate an auth key at https://login.tailscale.com/admin/settings/keys
# Use an ephemeral key so the node is removed from the tailnet when the container stops
TAILSCALE_AUTHKEY=
# Node name this machine appears as in the tailnet — change per developer to avoid conflicts
TS_HOSTNAME=revolt-gui-dev

# Frontend (set by docker-compose in Docker; override here for non-Docker dev)
VITE_API_BASE_URL=http://localhost:8000
VITE_MARTIN_URL=http://localhost:3000

# ENC pipeline (infra/enc-pipeline/) -- locally-sourced S-57 chart data, not
# committed to this repo. Point at wherever the Oslo Fjord ENC delivery lives
# on your machine, then run infra/enc-pipeline/run.sh (see its README for
# details and the data licensing note). Not read by docker-compose itself.
# ENC_SOURCE_DIR=/path/to/DNV/delivery
