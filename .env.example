# Copy to .env before running docker compose up
# .env is gitignored

# Postgres
POSTGRES_USER=revolt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=revolt_dev

# Backend
DATABASE_URL=postgresql+asyncpg://revolt:changeme@db:5432/revolt_dev
SECRET_KEY=dev-insecure-change-in-prod
ENVIRONMENT=development

# Vessel connection (read by FastAPI config, used once ROS2 bridge is implemented)
VESSEL_HOST=revolt-onboard
ROS2_BRIDGE_PORT=9090

# Tailscale sidecar
# Leave TAILSCALE_AUTHKEY empty to run without joining the tailnet (local dev only)
# Generate an auth key at https://login.tailscale.com/admin/settings/keys
# Use an ephemeral key so the node is removed from the tailnet when the container stops
TAILSCALE_AUTHKEY=
# Node name this machine appears as in the tailnet — change per developer to avoid conflicts
TS_HOSTNAME=revolt-gui-dev

# Frontend (set by docker-compose in Docker; override here for non-Docker dev)
VITE_API_BASE_URL=http://localhost:8000
