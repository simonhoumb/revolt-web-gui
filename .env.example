```dotenv
# ==============================================================================
# Environment Configuration
#
# Copy this file to `.env` before running `docker compose up`.
# The `.env` file is ignored by Git.
# ==============================================================================


# ==============================================================================
# PostgreSQL
# ==============================================================================

# Database user.
POSTGRES_USER=revolt

# Database password.
# Change this for any shared or production deployment.
POSTGRES_PASSWORD=changeme

# Database name.
POSTGRES_DB=revolt_dev


# ==============================================================================
# Backend
# ==============================================================================

# SQLAlchemy database connection string.
DATABASE_URL=postgresql+asyncpg://revolt:changeme@db:5432/revolt_dev

# Secret used for signing tokens and other cryptographic operations.
# Replace with a secure random value outside development.
SECRET_KEY=dev-insecure-change-in-prod

# Application environment.
# Valid values: development, production.
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins.
# Uncomment when accessing the frontend over Tailscale.
#
# Example:
#   http://localhost:5173,http://revolt-gui-dev:5173
#
# ALLOWED_ORIGINS=http://localhost:5173,http://revolt-gui-dev:5173


# ==============================================================================
# ROS 2 Bridge
# ==============================================================================

# Hostname or IP address of the rosbridge server.
#
# Common configurations:
#
#   Local mock (docker compose --profile mock up):
#     VESSEL_HOST=rosbridge-mock
#     BRIDGE_TARGET=physical
#
#   Physical vessel via Tailscale (docker compose --profile vessel up):
#     VESSEL_HOST=vessel-proxy
#     BRIDGE_TARGET=physical
#
#   Physical vessel on the local LAN:
#     VESSEL_HOST=192.168.1.100
#     BRIDGE_TARGET=physical
#
#   rosbridge running on this development machine
#   (e.g. rosbag playback using host-gateway):
#     VESSEL_HOST=host-gateway
#     BRIDGE_TARGET=physical
#
#   Simulation:
#     VESSEL_HOST=<sim-host-tailscale-name>
#     BRIDGE_TARGET=simulation
VESSEL_HOST=rosbridge-mock

# rosbridge WebSocket port.
ROS2_BRIDGE_PORT=9090

# ROS topic namespace to connect to.
# Valid values: physical, simulation.
BRIDGE_TARGET=physical

# Real-world latitude/longitude corresponding to the simulation origin
# (X=0, Y=0). Used to convert simulated Cartesian coordinates into WGS84
# for map display.
#
# Default:
#   Bekkelaget, Oslo Fjord
#
# SIM_GNSS_ORIGIN_LAT=59.9083
# SIM_GNSS_ORIGIN_LON=10.7512


# ==============================================================================
# Tailscale
# ==============================================================================

# Authentication key used to join the tailnet automatically.
#
# Leave empty for local development.
# Generate an ephemeral auth key from the Tailscale admin console.
TAILSCALE_AUTHKEY=

# Hostname this machine appears as within the tailnet.
# Use a unique hostname per developer.
TS_HOSTNAME=revolt-gui-dev


# ==============================================================================
# Frontend
# ==============================================================================

# Backend API base URL.
# Docker Compose sets this automatically; override for non-Docker development.
VITE_API_BASE_URL=http://localhost:8000

# Martin vector tile server URL.
# Docker Compose sets this automatically; override for non-Docker development.
VITE_MARTIN_URL=http://localhost:3000


# ==============================================================================
# ENC Pipeline
# ==============================================================================

# Path to the local DNV S-57 ENC delivery.
#
# Used by:
#   infra/enc-pipeline/run.sh
#
# This variable is not read by Docker Compose.
#
# Example:
#   /path/to/DNV/delivery
#
# ENC_SOURCE_DIR=
```
