{
	"version": 8,
	"name": "Oslo Fjord (light)",
	"glyphs": "/tiles/font/{fontstack}/{range}",
	"sources": {
		"oslo-fjord": {
			"type": "vector",
			"url": "/tiles/oslo-fjord"
		},
		"carto-basemap": {
			"type": "raster",
			"tiles": [
				"https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png",
				"https://b.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png",
				"https://c.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png",
				"https://d.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png"
			],
			"tileSize": 256,
			"attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors &copy; <a href=\"https://carto.com/attributions\">CARTO</a>"
		}
	},
	"layers": [
		{
			"id": "background",
			"type": "background",
			"paint": { "background-color": "#d8ecf3" }
		},
		{
			"id": "carto-basemap",
			"type": "raster",
			"source": "carto-basemap"
		},
		{
			"id": "lndare",
			"type": "fill",
			"source": "oslo-fjord",
			"source-layer": "lndare",
			"paint": { "fill-color": "#f2ecd8" }
		},
		{
			"id": "depare",
			"type": "fill",
			"source": "oslo-fjord",
			"source-layer": "depare",
			"paint": {
				"fill-color": [
					"interpolate",
					["linear"],
					["coalesce", ["get", "DRVAL1"], 0],
					0,
					"#c9e8f5",
					5,
					"#a9d8ec",
					10,
					"#8ac8e3",
					20,
					"#5fb0d6",
					50,
					"#2f8fc0"
				]
			}
		},
		{
			"id": "coalne",
			"type": "line",
			"source": "oslo-fjord",
			"source-layer": "coalne",
			"paint": { "line-color": "#5a5040", "line-width": 1.2 }
		},
		{
			"id": "slcons",
			"type": "line",
			"source": "oslo-fjord",
			"source-layer": "slcons",
			"minzoom": 10,
			"paint": { "line-color": "#3a3a3a", "line-width": 1 }
		},
		{
			"id": "depcnt-line",
			"type": "line",
			"source": "oslo-fjord",
			"source-layer": "depcnt",
			"minzoom": 9,
			"paint": { "line-color": "#4a90b8", "line-width": 0.6 }
		},
		{
			"id": "depcnt-label",
			"type": "symbol",
			"source": "oslo-fjord",
			"source-layer": "depcnt",
			"minzoom": 11,
			"layout": {
				"text-field": ["to-string", ["get", "VALDCO"]],
				"text-font": ["Noto Sans Regular"],
				"text-size": 10
			},
			"paint": {
				"text-color": "#2f5f7a",
				"text-halo-color": "#ffffff",
				"text-halo-width": 1
			}
		},
		{
			"id": "resare",
			"type": "fill",
			"source": "oslo-fjord",
			"source-layer": "resare",
			"paint": {
				"fill-color": "#c85050",
				"fill-opacity": 0.15,
				"fill-outline-color": "#c85050"
